<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b1020">
<title>PSEUDOCODE | SMM Panel</title>

<style>
:root {
  --bg: #0b1020;
  --card: #141c30;
  --border: #293550;
  --text: #f5f7ff;
  --muted: #9ba8c2;
  --accent: #8b5cf6;
  --green: #34d399;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

header {
  padding: 18px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-bottom: 1px solid var(--border);
  background: #0e1528;
  position: sticky;
  top: 0;
  z-index: 2;
}

.logo {
  font-size: 19px;
  font-weight: 800;
  letter-spacing: 1px;
}

.logo span {
  color: #a78bfa;
}

.badge {
  color: var(--green);
  border: 1px solid #256b55;
  padding: 7px 10px;
  border-radius: 20px;
  font-size: 11px;
}

main {
  max-width: 1100px;
  margin: auto;
  padding: 28px 18px 60px;
}

.hero {
  padding: 34px 25px;
  background: linear-gradient(135deg, #211749, #172b48);
  border: 1px solid #41316c;
  border-radius: 20px;
  margin-bottom: 24px;
}

.eyebrow {
  color: #c4b5fd;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 2px;
}

h1 {
  font-size: clamp(30px, 7vw, 48px);
  line-height: 1.12;
  margin: 15px 0;
}

.hero p, .muted {
  color: var(--muted);
  line-height: 1.6;
}

.button {
  background: var(--accent);
  color: white;
  padding: 13px 17px;
  border: 0;
  border-radius: 10px;
  font-weight: bold;
}

.secondary {
  background: #222d45;
  border: 1px solid var(--border);
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 20px 0 30px;
}

.card {
  background: var(--card);
  border: 1px solid var(--border);
  padding: 17px;
  border-radius: 14px;
  min-width: 0;
}

.stat-number {
  font-size: 24px;
  font-weight: bold;
  margin-top: 10px;
}

.label {
  color: var(--muted);
  font-size: 13px;
}

.layout {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 18px;
  align-items: start;
}

h2 {
  font-size: 20px;
  margin-top: 0;
}

form {
  display: grid;
  gap: 15px;
}

label {
  display: block;
  font-size: 13px;
  margin-bottom: 8px;
  color: #d6def0;
}

input, select {
  width: 100%;
  padding: 13px;
  border-radius: 9px;
  color: white;
  background: #0d1527;
  border: 1px solid var(--border);
  outline: none;
}

input:focus, select:focus {
  border-color: var(--accent);
}

select option {
  background: #141c30;
}

.price-box {
  padding: 15px;
  background: #0d1527;
  border-radius: 10px;
  border: 1px solid var(--border);
}

.price {
  font-size: 25px;
  color: var(--green);
  font-weight: bold;
  margin-top: 8px;
}

.notice {
  font-size: 12px;
  color: #fbbf24;
  line-height: 1.5;
}

.orders {
  margin-top: 24px;
}

.order {
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
  overflow-wrap: anywhere;
}

.status {
  display: inline-block;
  margin-top: 7px;
  padding: 5px 8px;
  border-radius: 6px;
  background: #3b2d12;
  color: #fbbf24;
  font-size: 11px;
}

.empty {
  padding: 20px 0;
  color: var(--muted);
  font-size: 14px;
}

footer {
  text-align: center;
  padding: 25px;
  color: var(--muted);
  border-top: 1px solid var(--border);
  font-size: 12px;
}

@media (max-width: 650px) {
  header {
    padding: 15px;
  }

  .logo {
    font-size: 16px;
  }

  main {
    padding: 20px 13px 40px;
  }

  .hero {
    padding: 25px 18px;
  }

  .stats {
    gap: 8px;
  }

  .card {
    padding: 12px;
  }

  .stat-number {
    font-size: 19px;
  }

  .layout {
    grid-template-columns: 1fr;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">PSEUDO<span>CODE</span></div>
  <div class="badge">● DEMO MODE</div>
</header>

<main>
  <section class="hero">
    <div class="eyebrow">SOCIAL MEDIA MARKETING</div>
    <h1>Grow your social presence.</h1>
    <p>
      Explore promotional services, estimate prices and test the
      ordering experience from one simple dashboard.
    </p>
    <button class="button" onclick="document.getElementById('order-form').scrollIntoView({behavior:'smooth'})">
      Create an order ↓
    </button>
  </section>

  <section class="stats">
    <div class="card">
      <div class="label">Demo orders</div>
      <div class="stat-number" id="order-count">0</div>
    </div>
    <div class="card">
      <div class="label">Wallet balance</div>
      <div class="stat-number">₦0</div>
    </div>
    <div class="card">
      <div class="label">System</div>
      <div class="stat-number" style="color:var(--green);font-size:16px">Demo</div>
    </div>
  </section>

  <section class="layout">
    <div class="card">
      <h2>Create an order</h2>
      <p class="muted">Try the order form. No payment will be collected.</p>

      <form id="order-form">
        <div>
          <label for="platform">Social platform</label>
          <select id="platform">
            <option value="Instagram">Instagram</option>
            <option value="TikTok">TikTok</option>
            <option value="YouTube">YouTube</option>
            <option value="Facebook">Facebook</option>
            <option value="Telegram">Telegram</option>
            <option value="X">X (Twitter)</option>
          </select>
        </div>

        <div>
          <label for="service">Service</label>
          <select id="service"></select>
        </div>

        <div>
          <label for="quantity">Quantity</label>
          <input id="quantity" type="number" min="100" max="10000"
                 step="100" value="1000" required>
          <p class="muted" style="font-size:12px">
            Demo quantities: 100–10,000 units.
          </p>
        </div>

        <div>
          <label for="target">Public post or channel URL</label>
          <input id="target" type="url" placeholder="https://example.com/your-post"
                 maxlength="500" required>
        </div>

        <div class="price-box">
          <div class="label">Estimated demo price</div>
          <div class="price" id="price">₦1,000</div>
          <div class="label">Illustrative price only, not a live provider quote.</div>
        </div>

        <button class="button" type="submit">Place demo order</button>
        <div class="notice">
          Demo only. This form does not make real payments, send orders
          to a provider or promise engagement delivery.
        </div>
      </form>
    </div>

    <div class="card">
      <h2>Available categories</h2>
      <div class="order">
        <strong>📸 Instagram</strong>
        <p class="muted">Likes and audience promotion</p>
      </div>
      <div class="order">
        <strong>🎵 TikTok</strong>
        <p class="muted">Video promotion</p>
      </div>
      <div class="order">
        <strong>▶️ YouTube</strong>
        <p class="muted">Video discovery and promotion</p>
      </div>
      <div class="order">
        <strong>👥 Facebook</strong>
        <p class="muted">Page and post promotion</p>
      </div>
      <div class="order">
        <strong>✈️ Telegram</strong>
        <p class="muted">Channel promotion</p>
      </div>
      <div class="order">
        <strong>𝕏 X</strong>
        <p class="muted">Post promotion</p>
      </div>
    </div>
  </section>

  <section class="card orders">
    <h2>Recent demo orders</h2>
    <div id="orders-list" class="empty">
      No demo orders yet. Submit the form above to try it.
    </div>
    <button class="button secondary" id="clear-orders" type="button">
      Clear demo orders
    </button>
  </section>
</main>

<footer>
  PSEUDOCODE SMM PANEL · DEMO VERSION · No real payments or fulfillment
</footer>

<script>
const catalog = {
  Instagram: [
    { name: "Content promotion", rate: 1000 },
    { name: "Audience campaign", rate: 1800 }
  ],
  TikTok: [
    { name: "Video promotion", rate: 700 },
    { name: "Engagement campaign", rate: 1500 }
  ],
  YouTube: [
    { name: "Video discovery campaign", rate: 2500 },
    { name: "Channel promotion", rate: 3000 }
  ],
  Facebook: [
    { name: "Page promotion", rate: 1200 },
    { name: "Post promotion", rate: 900 }
  ],
  Telegram: [
    { name: "Channel discovery campaign", rate: 800 },
    { name: "Channel promotion", rate: 1300 }
  ],
  X: [
    { name: "Post promotion", rate: 1000 },
    { name: "Profile promotion", rate: 1600 }
  ]
};

let orders = [];

const platform = document.getElementById("platform");
const service = document.getElementById("service");
const quantity = document.getElementById("quantity");
const price = document.getElementById("price");

function updateServices() {
  service.innerHTML = "";

  catalog[platform.value].forEach((item, index) => {
    const option = document.createElement("option");
    option.value = String(index);
    option.textContent = item.name;
    service.appendChild(option);
  });

  updatePrice();
}

function updatePrice() {
  const item = catalog[platform.value][Number(service.value)] ||
               catalog[platform.value][0];
  const amount = Number(quantity.value) || 0;
  const total = item.rate * amount / 1000;

  price.textContent = "₦" + Math.round(total).toLocaleString("en-NG");
}

function renderOrders() {
  document.getElementById("order-count").textContent = orders.length;

  const list = document.getElementById("orders-list");
  list.replaceChildren();

  if (orders.length === 0) {
    list.className = "empty";
    list.textContent = "No demo orders yet. Submit the form above to try it.";
    return;
  }

  list.className = "";

  orders.forEach(order => {
    const item = document.createElement("div");
    item.className = "order";

    const title = document.createElement("strong");
    title.textContent = order.platform + " — " + order.service;

    const details = document.createElement("p");
    details.className = "muted";
    details.textContent = "Order #" + order.id +
      " · Quantity: " + order.quantity +
      " · " + order.price;

    const status = document.createElement("span");
    status.className = "status";
    status.textContent = "DEMO — NOT SENT";

    item.append(title, details, status);
    list.appendChild(item);
  });
}

platform.addEventListener("change", updateServices);
service.addEventListener("change", updatePrice);
quantity.addEventListener("input", updatePrice);

document.getElementById("order-form").addEventListener("submit", event => {
  event.preventDefault();

  const amount = Number(quantity.value);
  const target = document.getElementById("target").value.trim();

  if (!Number.isInteger(amount) || amount < 100 || amount > 10000) {
    alert("Enter a quantity between 100 and 10,000.");
    return;
  }

  try {
    const url = new URL(target);

    if (url.protocol !== "https:" && url.protocol !== "http:") {
      throw new Error("Invalid protocol");
    }
  } catch {
    alert("Enter a valid public URL beginning with https:// or http://.");
    return;
  }

  const item = catalog[platform.value][Number(service.value)];

  orders.unshift({
    id: Date.now().toString().slice(-8),
    platform: platform.value,
    service: item.name,
    quantity: amount,
    price: price.textContent
  });

  renderOrders();
  alert("Demo order created! No payment was taken and no service was sent.");
});

document.getElementById("clear-orders").addEventListener("click", () => {
  orders = [];
  renderOrders();
});

updateServices();
renderOrders();
</script>

</body>
</html>
