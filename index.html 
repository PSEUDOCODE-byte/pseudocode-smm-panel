<style>
:root{--bg:#090909;--panel:#141414;--gold:#d9b45b;--light:#f6df9a;--text:#f6f3eb;--muted:#aaa49a;--border:rgba(217,180,91,.25)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 70% -10%,#d9b45b20,transparent 38%),var(--bg);color:var(--text);font:16px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:inherit;text-decoration:none}button,input,select{font:inherit}.wrap{width:min(1100px,calc(100% - 30px));margin:auto}
header{position:sticky;top:0;z-index:5;background:#090909eF;backdrop-filter:blur(12px);border-bottom:1px solid #ffffff12}
nav{min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:15px}.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:.08em;font-size:.9rem}.mark{display:grid;place-items:center;width:39px;height:39px;border:1px solid var(--gold);border-radius:12px;color:var(--light)}small{display:block;color:var(--gold);font-size:.62rem;letter-spacing:.2em}
.links{display:flex;gap:22px;color:var(--muted);font-size:.9rem}.links a:hover{color:var(--light)}
.btn{display:inline-flex;justify-content:center;align-items:center;border:1px solid var(--border);border-radius:12px;padding:11px 16px;background:transparent;color:var(--text);font-weight:750;cursor:pointer}.gold{background:linear-gradient(135deg,var(--light),#bd9132);color:#17130a;border-color:transparent}
.hero{padding:70px 0 45px;display:grid;grid-template-columns:1.1fr .9fr;gap:36px;align-items:center}.eyebrow{display:inline-block;padding:6px 11px;border:1px solid var(--border);border-radius:99px;color:var(--light);background:#d9b45b0c;font-size:.75rem;letter-spacing:.1em;font-weight:800;text-transform:uppercase}
h1{font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.03;letter-spacing:-.05em;margin:20px 0}.shine{color:var(--light)}p{color:var(--muted)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:23px}.trust{display:flex;gap:15px;flex-wrap:wrap;color:#d0c9b9;font-size:.8rem;margin-top:22px}.trust span:before{content:"✓ ";color:var(--gold)}
.preview,.panel,.card{background:linear-gradient(145deg,#191919,#101010);border:1px solid var(--border);border-radius:20px;padding:21px}.preview{box-shadow:0 25px 70px #0008}.dashhead,.total{display:flex;justify-content:space-between;gap:12px;align-items:center}.pill{font-size:.7rem;border:1px solid var(--border);color:var(--light);border-radius:99px;padding:4px 9px}.balance{padding:20px 0}.balance span,.mini span{font-size:.8rem;color:var(--muted)}.balance h2{font-size:2.1rem;margin:0}.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mini{background:#ffffff08;border:1px solid #ffffff0c;border-radius:13px;padding:13px}.mini span{display:block}.mini b{display:block;margin-top:4px}.spark{display:flex;align-items:end;gap:7px;height:55px;margin-top:18px}.spark i{flex:1;border-radius:4px 4px 0 0;background:linear-gradient(var(--light),#85621f)}
section.section{padding:42px 0}.section h2{font-size:clamp(1.7rem,4vw,2.4rem);margin:12px 0 4px;letter-spacing:-.035em}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}.card{border-color:#ffffff12;transition:.2s}.card:hover{transform:translateY(-3px);border-color:var(--border)}.icon{width:43px;height:43px;display:grid;place-items:center;border:1px solid var(--border);border-radius:13px;color:var(--light);font-size:1.2rem}.card h3{margin:13px 0 4px}.card p{font-size:.9rem;min-height:44px}.price{color:var(--light);font-weight:850}.price small{display:inline;color:var(--muted);letter-spacing:0;font-size:.75rem;font-weight:500}
.ordergrid{display:grid;grid-template-columns:1fr .8fr;gap:16px;align-items:start}.panel h3{margin:0}.sub{font-size:.88rem;margin:5px 0 18px}.field{margin-bottom:14px}label{display:block;margin-bottom:6px;font-size:.83rem;font-weight:750}input,select{width:100%;background:#090909;color:var(--text);border:1px solid #37332a;border-radius:10px;padding:12px;outline:none}input:focus,select:focus{border-color:var(--gold)}.total{border-top:1px solid #ffffff15;padding-top:14px;margin-top:10px}.total span{color:var(--muted)}.total strong{font-size:1.4rem;color:var(--light)}.full{width:100%;margin-top:15px}.notice{font-size:.8rem;color:#d5c49b;border:1px solid var(--border);background:#d9b45b0b;padding:11px;border-radius:11px;margin-top:13px}.message{color:var(--light);font-size:.84rem;margin-top:10px}.steps{display:grid;gap:14px}.step{display:flex;gap:12px;padding-bottom:13px;border-bottom:1px solid #ffffff10}.num{min-width:32px;height:32px;display:grid;place-items:center;border:1px solid var(--border);border-radius:10px;color:var(--light)}.step b{display:block}.step p{font-size:.85rem;margin:3px 0 0}.faq{display:grid;grid-template-columns:1fr 1fr;gap:12px}details{background:#121212;border:1px solid #ffffff13;border-radius:12px;padding:15px}summary{font-weight:750;cursor:pointer}details p{font-size:.9rem;margin-bottom:0}footer{border-top:1px solid #ffffff12;margin-top:20px;padding:24px 0;color:var(--muted);font-size:.8rem}.foot{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
.modalbg{display:none;position:fixed;inset:0;z-index:10;background:#000c;place-items:center;padding:16px}.modalbg.open{display:grid}.modal{width:min(420px,100%);background:#141414;border:1px solid var(--border);border-radius:18px;padding:21px}.modalhead{display:flex;justify-content:space-between;align-items:center}.close{background:#252525;color:white;border:0;border-radius:8px;padding:7px 12px;font-size:1.2rem}.switch{display:flex;gap:8px;margin:15px 0}.switch button{flex:1}.switch .active{color:var(--light);border-color:var(--gold)}
@media(max-width:760px){.links{display:none}.hero{grid-template-columns:1fr;padding-top:45px}.preview{max-width:560px;width:100%;margin:auto}.ordergrid{grid-template-columns:1fr}.section{padding:32px 0}.sectionhead{align-items:start}}
@media(max-width:520px){.cards,.faq{grid-template-columns:1fr}.hero{gap:25px}.hero h1{font-size:2.65rem}.brand{font-size:.76rem}.mark{width:35px;height:35px}nav>.btn{padding:9px 11px;font-size:.82rem}.wrap{width:calc(100% - 24px)}}
</style></head><body>
<header><nav class="wrap"><a class="brand" href="#home"><span class="mark">P</span><span>PSEUDOCODE<small>SMM PANEL</small></span></a><div class="links"><a href="#services">Services</a><a href="#order">Quick order</a><a href="#how">How it works</a><a href="#faq">FAQ</a></div><button class="btn gold" data-open="login">Sign in ↗</button></nav></header>
<main id="home"><section class="wrap hero"><div><span class="eyebrow">✦ Premium social growth</span><h1>Grow your presence.<br><span class="shine">Own the spotlight.</span></h1><p>A sleek, black-and-gold social media services panel concept. Designed for creators and businesses, with a mobile-friendly catalog and order preview.</p><div class="actions"><a class="btn gold" href="#order">Explore services →</a><a class="btn" href="#how">How it works</a></div><div class="trust"><span>Mobile-first design</span><span>Clear pricing</span><span>Order preview</span></div></div>
